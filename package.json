{
  "scripts": {
    "start": "node --use-system-ca server.js",
    "stress:test": "node scripts/stress-test.js",
    "stress:burst": "node scripts/stress-test.js --users 25 --iterations 6 --ramp-ms 50",
    "stress:heavy": "node scripts/stress-test.js --users 60 --iterations 10 --ramp-ms 25 --x-packets 1000",
    "stress:last-packets": "node scripts/stress-test.js --users 20 --iterations 8 --mode last-packets",
    "stress:refresh": "node scripts/stress-test.js --users 20 --iterations 10 --mode refresh --ramp-ms 0",
    "stress:multi-db": "node scripts/stress-test.js --users 20 --iterations 6 --mode multi-db --num-databases 3",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.59.1",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^9.39.1",
    "events": "^3.3.0",
    "globals": "^16.4.0",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "punycode": "^1.4.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "timers-browserify": "^2.0.12",
